# SEC EDGAR requires a compliant User-Agent header on every request:
# "Sample Company Name AdminContact@sample.com"
# No API key needed — just identify yourself honestly per SEC's fair-access rules.
# https://www.sec.gov/os/webmaster-faq#developers
EDGAR_USER_AGENT="Your Name your-email@example.com"

# Base URL for SEC EDGAR's data API (company facts, submissions, filings)
EDGAR_BASE_URL="https://data.sec.gov"

# Pilot tickers for Phase 1 (comma-separated), e.g. for early filing-retriever testing
PILOT_TICKERS="AAPL,MSFT,NVDA"

# LLM backend for Phase 4 (DSPy claim extraction) and Phase 7 (RLVR/GRPO fine-tuning
# base model calls). OpenAI-compatible endpoint — a self-hosted / bootcamp-provided
# server, not a public API. Only reachable from within that network, so DSPy code
# that calls this must be run from a machine with access to it, not from here.
LLM_BASE_URL="http://10.0.10.51:8000/v1"
LLM_API_KEY="dummy-key"
LLM_MODEL="openai/gpt-oss-20b"
LLM_TIMEOUT_SECONDS=120
